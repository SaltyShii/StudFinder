{
  "name": "stud-finder",
  "private": true,
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/scoring && tsc --noEmit -p apps/web",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
